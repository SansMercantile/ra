# AWS credentials for Bedrock (via bedrockClient.ts).
# Not needed if running with an IAM role (EC2/ECS/Lambda) or an AWS profile
# already configured locally (~/.aws/credentials) -- the AWS SDK's default
# credential chain picks those up automatically. Only set these if you need
# to override with explicit keys.
# AWS_ACCESS_KEY_ID="MY_ACCESS_KEY_ID"
# AWS_SECRET_ACCESS_KEY="MY_SECRET_ACCESS_KEY"
# AWS_SESSION_TOKEN="MY_SESSION_TOKEN"

# VITE_API_BASE_URL: base URL of the standalone ra-backend API (now a separate
# service in constellation/ra-backend, deployed independently). The frontend
# prefixes all /api calls with this. Leave blank only if the backend is served
# from the same origin (it is not, in production).
VITE_API_BASE_URL="https://api.ra.sansmercantile.com"

# AWS_REGION: legacy (the frontend no longer calls Bedrock directly; the backend does).
AWS_REGION="us-east-1"


